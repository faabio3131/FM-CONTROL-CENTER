NODE_ENV=development
DATABASE_URL=postgresql://fmcc:fmcc@localhost:5432/fmcc
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
RUN_MIGRATIONS_ON_STARTUP=false

# FMCC Product-Owned Cognitive Vertical Core
# Configure an OpenAI-compatible model endpoint at runtime. Never commit real secrets.
FMCC_COGNITIVE_MODEL_BASE_URL=https://api.openai.com
FMCC_COGNITIVE_MODEL_API_KEY=replace-with-runtime-secret
FMCC_COGNITIVE_MODEL_ID=replace-with-approved-model


# Kordena — plano de controle comercial governado
# Tenant interno do FMCC autorizado a consumir a fonte comercial global do Kordena.
FMCC_KORDENA_CONTROL_TENANT_ID=replace-with-nova-fm-control-tenant-id
# Origens HTTPS permitidas, separadas por vírgula. Fora da allowlist = fail-closed.
FMCC_KORDENA_ALLOWED_ORIGINS=https://kordena-preview.example.com
# Segredo dedicado de runtime. A source deve referenciar exatamente:
# env:FMCC_KORDENA_CONTROL_PLANE_TOKEN
FMCC_KORDENA_CONTROL_PLANE_TOKEN=replace-with-runtime-secret


# Avaliação proativa de alertas
# Segredo exclusivo do scheduler/cron. Nunca enviar ao navegador ou commitar valor real.
FMCC_ALERT_AUTOMATION_SCHEDULER_SECRET=replace-with-runtime-secret-at-least-32-chars

# KF-03 — Kordena live runtime bootstrap (one-time, idempotent)
# Enable only during controlled registration/verification, then disable.
FMCC_KORDENA_RUNTIME_BOOTSTRAP=false
FMCC_KORDENA_RUNTIME_BOOTSTRAP_VERIFY=false
# Real HTTPS Kordena runtime base URL. Must be included in ALLOWED_ORIGINS.
FMCC_KORDENA_BASE_URL=https://kordena-preview.example.com
# Controlled in-memory S2S origin correction. Default OFF.
# These flags do not update the PostgreSQL source definition.
# Enable only after validating the dedicated HTTPS control-plane, matching FM tenant,
# control-plane tokens, and each domain in the corresponding ALLOWED_ORIGINS.
FMCC_KORDENA_SOURCE_ORIGIN_OVERRIDE=false
FMCC_IRON_SOURCE_ORIGIN_OVERRIDE=false
# When using the IRON override, configure all three existing variables on the server:
# FMCC_IRON_CONTROL_TENANT_ID=<existing-fm-tenant-id>
# FMCC_IRON_BASE_URL=https://api.ironfitcore.com.br
# FMCC_IRON_ALLOWED_ORIGINS=https://api.ironfitcore.com.br
# Never commit real service tokens or mark the IRON HOMOLOG runtime as production.


# Vende PSP read-only observation producer: construction default OFF.
# No live activation until complete internal build and external authorization.
FM_COMMAND_VENDE_PAYMENT_READBACK_ENABLED=false

# FM Command V1: IRON subscription Cakto platform account (global FM, not academy payments).
# Missing any real value keeps checkout and payment reconciliation fail-closed.
# FMCC_CAKTO_WEBHOOK_SECRET=
# FMCC_CAKTO_CHECKOUTS_JSON=[{"offerId":"OFFICIAL_OFFER","productId":"OFFICIAL_PRODUCT","planCode":"IRON_PRO","checkoutUrl":"https://pay.cakto.com.br/REAL_CHECKOUT","amountMinor":26900,"interval":"month"}]
# FMCC_IRON_BILLING_TENANT_ID=
# FMCC_IRON_PRODUCT_ID=
# FMCC_IRON_COMMERCE_S2S_TOKEN=
# FMCC_IRON_CONTROL_PLANE_URL=https://api.ironfitcore.com.br/api/v1/control-plane/fmcc
# FMCC_IRON_CONTROL_PLANE_TOKEN=
# FMCC_IRON_GRACE_DAYS=3
# FMCC_ALERT_AUTOMATION_SCHEDULER_SECRET=
# Worker endpoint: POST /api/internal/automation/iron/entitlements/drain
# Cakto webhook endpoint: POST /api/webhooks/iron/cakto
# IRON proxy endpoint: GET/POST /api/internal/iron/commerce/checkout

# IRON Intelligence one-time credits — CANONICAL FM Command V1 only.
# Defaults OFF; no Cakto offer or sale is enabled by deploying code.
# Official Cakto seller must define EXACT planCodes IRON_AI_WORKOUT_100/300/1000,
# intervals one_time, official offerId/productId, safe checkout URL and cent prices.
FMCC_IRON_COMMERCIAL_SALES_ENABLED=false
# FMCC_IRON_CREDITS_CHECKOUT_TOKEN=<dedicated-backend-only-secret-at-least-32-characters>
# Backend URL uses https://app.fmcommand.com.br/api/internal/iron/ai-credits/checkout
# Webhook POST /api/webhooks/iron/cakto/ai-credits uses existing Cakto signed key.
# Worker POST /api/internal/automation/iron/ai-credits/drain uses existing scheduler secret.
# GitHub variable FMCC_CAKTO_CREDITS_OUTBOX_ENABLED remains absent/false until externally approved.
